{
    "cmd": [
        "g++.exe",
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Wshadow",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-DLOCAL",
        "${file}",
        "-o",
        "${file_base_name}.exe",
        "&&",
        "${file_base_name}.exe<input.txt>output.txt"
    ],
    "shell": true,
    "working_dir": "$file_path",
    "selector": "source.cpp"
}

// g++ -std=c++20 -O2 -Wall -Wextra -Wshadow -Wno-unused-variable -Wno-unused-parameter -DLOCAL
