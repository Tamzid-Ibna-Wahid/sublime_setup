// binomial coefficient O(r)
int nCr(int n, int r) {
    int sum = 1;
    for (int i = 1; i <= r; i++) {
        sum = sum * (n - r + i);
        sum /= i;
    }
    return sum;
}



// calculate a^n
int binExp(int a, int n) {
    int res = 1;
    while (n > 0) {
        if (n & 1) {
            res *= a;
        }
        a *= a;
        n >>= 1;
    }
    return res;
}


 // a^n % M  =  ((a % M ) ^ n) % M

 // calculate a^n % M
int modExp(int a, int n, int M) {
    int res = 1;
     a %= M;
    while (n > 0) {
        if (n & 1) {
            res = (res * a) % M;
        }
        a = (a * a) % M;
        n >>= 1;
    }
    return res;
}





 // calculate a^n % M

   int modExp_for_large_a(int a, int n, int M) {
    // a ke agei Mod kore choto  kore nisi
      a=modExp(2,1024,M); // when a<= 2^1024 (a is big)
    int res = 1;
    while (n > 0) {
        if (n & 1) {
            res = (res * a) % M;
        }
        a = (a * a) % M;
        n >>= 1;
    }
    return res;
}


int binMultiply(int a, int b, int M) {
    int res = 0;
    while (b > 0) {
        if (b & 1) {
            res = (res + a) % M;
        }
        a = (a + a) % M;
        b >>= 1;
    }
    return res;
}

// whem M<=10^18  (M is big)
int modExp_for_big_M(int a, int n, int M) {
    int res = 1;
    while (n > 0) {
        if (n % 2 != 0) {
            res = binMultiply(res, a, M);
        }
        a = binMultiply(a, a, M);
        n >>= 1;
    }
    return res;
}


 // a^b^c % M = (a ^ (b^c % M-1)) % M  (if M prime number)
 int DoublePower(int a,int b,int c,int M){
     return  modExp(a ,modExp(b ,c ,M-1), M);
 }


 //Modular multiplicatiob invirse
// Using Fermat's Little Theorem: a^(M-1) ≡ 1 (mod M)
// Therefore, a^(M-2) ≡ a^(-1) (mod M)

 int modInverse(int a, int M) {
    return modExp(a, M - 2, M);
}



