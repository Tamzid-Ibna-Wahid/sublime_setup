//setting in here override default
{
	"ignored_packages": [
	], // Packages to ignore (disable). Add "Vintage" here if you don't want Vim keybindings.
	"vintage_ctrl_keys": true, // Enables `Ctrl` shortcuts while using Vintage mode (Vim emulation).

	"font_size": 13, // Sets the font size.
	"line_padding_top": 2, // Adds padding above each line to increase line spacing.
	"line_padding_bottom": 5, // Adds padding below each line to increase line spacing.
	"font_face": "Jetbrain Mono", // Sets the font to "Jetbrain Mono". Make sure this font is installed on your system.
	"highlight_line": true, // Highlights the current line you're editing.

	"trim_automatic_white_space": false, // If set to `true`, removes trailing whitespace inserted by auto-complete.
	"translate_tabs_to_spaces": true, // Converts tabs to spaces automatically, ensuring code indentation uses spaces.
	"word_wrap": false, // Disables word wrap so that lines do not automatically wrap; useful for viewing code in a single line.
	"auto_match_enabled": false, // Disables automatic bracket completion.

	// "save_on_focus_lost": true,

	"color_scheme": "Monokai.sublime-color-scheme", // Sets the color scheme to Monokai, giving syntax highlighting colors.

	"auto_complete": true, // If uncommented, disables autocomplete suggestions.
	// "auto_complete_commit_on_tab": true, // If uncommented, pressing Tab accepts the auto-complete suggestion.


	"theme": "Default Dark.sublime-theme", // Automatically switches between light and dark themes based on system theme.
	"index_files": true,


	"vintage_lines.force_mode": true,    // relative line show kore



}
