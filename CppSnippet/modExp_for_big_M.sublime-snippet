int binMultiply(int a, int b, int M) {
    int res = 0;
    while (b > 0) {
        if (b & 1) {
            res = (res + a) % M;
        }
        a = (a + a) % M;
        b >>= 1;
    }
    return res;
}

// whem M<=10^18  (M is big)
int modExp_for_big_M(int a, int n, int M) {
    int res = 1;
    while (n > 0) {
        if (n % 2 != 0) {
            res = binMultiply(res, a, M);
        }
        a = binMultiply(a, a, M);
        n >>= 1;
    }
    return res;
}
]]></content>
